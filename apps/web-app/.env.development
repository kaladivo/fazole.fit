# Local dev services from docker-compose.dev.yml (repo root), on ports that
# stay clear of linky's stack. `bun run dev` (vite development mode) loads this file.
VITE_NOSTR_RELAYS=ws://localhost:7787
VITE_EVOLU_SERVER_URLS=ws://localhost:4011
VITE_MAIN_MINT_URL=http://localhost:3348
VITE_ALLOW_INSECURE_LOCALHOST_RELAYS=1

# A local linky web-app dev server pointed at the same services: the employee's
# NIP-46 signer and the customer wallet in end-to-end tests.
VITE_LINKY_URL=http://localhost:5174
